# Copie para .env e preencha. Nunca commite o .env.

# Aplicativo Omie desta empresa (MVP: uma empresa)
OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_APP_NAME=

# Neon Postgres (preenchido automaticamente por `npx neon init`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# Usada para criptografar app_secret quando as chaves forem para o banco
ENCRYPTION_KEY=
