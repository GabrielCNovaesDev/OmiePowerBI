# =============================================================================
# Costa Novaes BI — variáveis de ambiente
# Copie este arquivo para .env (se ainda não existir) e preencha.
# NUNCA commite o .env. NÃO cole chaves no chat.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Postgres (Neon) — você JÁ tem
# Como conseguir: console.neon.tech → projeto → Connection string
# DATABASE_URL = pooled (app e ETL). DATABASE_URL_UNPOOLED = direta (migrations).
# -----------------------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# -----------------------------------------------------------------------------
# 2) Aplicativo Omie desta empresa (o primeiro; os próximos vão no banco)
# Como conseguir: Omie → Perfil / Aplicativos → API → App Key e App Secret
# Documentação: https://developer.omie.com.br/
# OMIE_APP_NAME = apelido só para humanos (ex.: "Instituto LM")
# Depois de `npm run migrate:aplicativo`, a carga lê do banco; estas duas
# linhas continuam úteis como fallback e para o script de migração.
# -----------------------------------------------------------------------------
OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_APP_NAME=

# Outra empresa: cadastre no Painel admin (Empresas Omie), nao neste arquivo.


# -----------------------------------------------------------------------------
# 3) Criptografia do app_secret no Postgres
# Obrigatória para `npm run migrate:aplicativo`.
# Como gerar (PowerShell / Node):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se esta chave for perdida, os secrets Omie no banco não dão para descriptografar.
# -----------------------------------------------------------------------------
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 4) Login (Auth.js)
# AUTH_SECRET: assina o cookie de sessão. Obrigatória em produção (Vercel).
# Como gerar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_URL: URL pública do site. Local = http://localhost:3000
# Em produção: https://seu-dominio.vercel.app
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 5) Primeiro usuário admin (você escolhe — NÃO precisa me enviar)
# Usado só por `npm run seed:admin`. Senha com no mínimo 10 caracteres.
# Este é o login da Costa Novaes (acesso a todas as empresas).
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Costa Novaes Admin

# -----------------------------------------------------------------------------
# 6) Produção — atualização automática (Vercel + GitHub)
# CRON_SECRET: qualquer string longa; a Vercel manda no header do cron.
# SYNC_GITHUB_TOKEN: Personal Access Token com permissão "Actions: write"
#   GitHub → Settings → Developer settings → Fine-grained ou classic (workflow)
# SYNC_GITHUB_REPO: dono/repositorio (ex.: GabrielCNovaesDev/CostaNovaesBI)
# No GitHub → Settings → Secrets and variables → Actions, grave também:
#   DATABASE_URL e APP_ENCRYPTION_KEY (os mesmos do .env)
# -----------------------------------------------------------------------------
CRON_SECRET=
SYNC_GITHUB_TOKEN=
SYNC_GITHUB_REPO=GabrielCNovaesDev/CostaNovaesBI
SYNC_GITHUB_REF=main

